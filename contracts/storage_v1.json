    "completion_queue": {
      "top": "ZtpuCompletionQueue8",
      "logical_depth": 8,
      "fields": ["tag:8", "opcode:4", "status:4", "error:8"],
      "timing": "cycle_exact",
      "overflow": "sticky_until_clear"
    }
  }
}
